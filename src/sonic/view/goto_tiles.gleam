//// The "Go to" tiles at the foot of the home page.
////
//// Four outbound links to Social Layer's own places. Static, so they live
//// here rather than coming from the API — upstream hard-codes them too.

import gleam/list
import lustre/attribute.{attribute}
import lustre/element.{type Element}
import lustre/element/html

pub fn view() -> Element(msg) {
  html.div([attribute.class("mt-8")], [
    html.h2(
      [
        attribute.class(
          "text-2xl font-semibold mb-3 md:flex-row flex items-center justify-between flex-col",
        ),
      ],
      [html.div([], [element.text("Go to")])],
    ),
    html.div(
      [
        attribute.class(
          "grid md:grid-cols-4 sm:grid-cols-3 grid-cols-2 gap-2",
        ),
      ],
      list.map(tiles(), tile),
    ),
  ])
}

fn tiles() -> List(#(String, String, String, Element(msg))) {
  [
    #(
      "https://www.sociallayer.im/",
      "About",
      "linear-gradient(180deg, #FFF6F3 0%, rgba(255, 255, 255, 0.00) 100%)",
      icon(about_svg),
    ),
    #(
      "https://social-layer.notion.site/Use-Badges-531bcb47d3694d45bd6c73da99b1ad6f?pvs=4",
      "What is Badge",
      "linear-gradient(180deg, #FFF2FB 0%, rgba(255, 255, 255, 0.00) 100%)",
      icon(badge_svg),
    ),
    #(
      "https://sola.day/",
      "Development Doc",
      "linear-gradient(180deg, #F3FFFE 0%, rgba(255, 255, 255, 0.00) 100%)",
      icon(doc_svg),
    ),
    #(
      "https://twitter.com/SocialLayer_im",
      "@SocialLayer_im",
      "linear-gradient(180deg, #EEF3F5 0%, rgba(255, 255, 255, 0.00) 100%)",
      // The X mark is a glyph in the shipped icon font, not an SVG.
      html.i([attribute.class("media-x text-xl")], []),
    ),
  ]
}

fn tile(entry: #(String, String, String, Element(msg))) -> Element(msg) {
  let #(href, label, background, mark) = entry
  html.a(
    [
      attribute.href(href),
      attribute("target", "_blank"),
      attribute("rel", "noopener noreferrer"),
      attribute.class(
        "h-[144px] rounded shadow p-4 duration-200 hover:translate-y-[-6px]",
      ),
      attribute.styles([#("background", background)]),
    ],
    [
      mark,
      html.div([attribute.class("text-lg font-semibold mt-2")], [
        element.text(label),
      ]),
    ],
  )
}

fn icon(markup: String) -> Element(msg) {
  element.unsafe_raw_html("", "span", [], markup)
}

